{
  "rules": {
    ".read": false,
    ".write": false,
    "games": {
      "$gameId": {
        ".read": "$gameId.matches(/^[a-z0-9]{6}$/)",
        ".write": "$gameId.matches(/^[a-z0-9]{6}$/)",
        "lastActive": {
          ".validate": "newData.isString() && newData.val().length < 40"
        },
        "players": {
          "$playerId": {
            "color": {
              ".validate": "newData.isString() && newData.val().length <= 7"
            },
            "money": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
            },
            "spent": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
            },
            "incomePosition": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
            },
            "roundStartMoney": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
            },
            "roundStartIncomePosition": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "linkScore": {
          "$era": {
            ".validate": "$era == 'canal' || $era == 'rail'",
            "links": {
              "$linkId": {
                ".validate": "newData.isString() && (newData.val() == 'pink' || newData.val() == 'yellow' || newData.val() == 'white' || newData.val() == 'red')"
              }
            },
            "icons": {
              "$locationId": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8"
              }
            },
            "at": {
              ".validate": "newData.isString() && newData.val().length < 40"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "undo": {
          "action": {
            ".validate": "newData.isString() && (newData.val() == 'reset' || newData.val() == 'removePlayer' || newData.val() == 'endRound')"
          },
          "at": {
            ".validate": "newData.isString() && newData.val().length < 40"
          },
          "linkScore": {
            "$era": {
              ".validate": "$era == 'canal' || $era == 'rail'",
              "links": {
                "$linkId": {
                  ".validate": "newData.isString() && (newData.val() == 'pink' || newData.val() == 'yellow' || newData.val() == 'white' || newData.val() == 'red')"
                }
              },
              "icons": {
                "$locationId": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8"
                }
              },
              "at": {
                ".validate": "newData.isString() && newData.val().length < 40"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "snapshot": {
            "$playerId": {
              "color": {
                ".validate": "newData.isString() && newData.val().length <= 7"
              },
              "money": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
              },
              "spent": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
              },
              "incomePosition": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
              },
              "roundStartMoney": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
              },
              "roundStartIncomePosition": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "presence": {
      "$gameId": {
        ".write": "$gameId.matches(/^[a-z0-9]{6}$/)",
        "$slot": {
          ".validate": "$slot.matches(/^slot[0-5]$/) && newData.hasChildren(['id', 'at']) && (!data.exists() || data.child('id').val() == newData.child('id').val() || data.child('at').val() < now - 43200000)",
          "id": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "at": {
            ".validate": "newData.isNumber() && newData.val() == now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
